{
  "name": "oh-share-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/identity/*.test.ts",
    "test:identity": "tsx --test src/identity/service.test.ts",
    "identity:accounts": "tsx src/identity/provision.ts",
    "identity:start": "tsx src/identity/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/oidc-provider": "9.12.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
